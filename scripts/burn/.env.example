# scripts/burn/benchmark.py config (python-decouple). Copy to .env and edit;
# the real .env is gitignored. Every key has a built-in default, so a bare
# `./scripts/burn/benchmark.py run` works with no .env present at all.

# lemonade OpenAI-compatible endpoint all three candidate models are served from
LEMONADE_BASE_URL=http://127.0.0.1:13305/api/v1
LEMONADE_KEY_ENV=LEMONADE_API_KEY

# comma-separated default candidate list for a bare `run` (no --models)
MODELS=Qwen3.6-35B-A3B-MTP-GGUF,Qwen3-Coder-Next-GGUF,Qwen3.6-27B-MTP-GGUF

MAX_TURNS=150
TASK_TIMEOUT=1200
OUT_DIR=~/burn-zelda3/ab

# Must match lemonade's llama-server --ctx-size (see linux_setup/lemonade/config.json
# ctx_size) so hermes's compression threshold is computed against the real
# runtime ceiling instead of each model's much larger registered context window.
LLM_CONTEXT_SIZE=131072
